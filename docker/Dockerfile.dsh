FROM stefankhor/dsh-docker@sha256:10dd87d6ee9c516c9ac73e0c07b885bba8379513a3b7accc5b68da2e1d2d0fe1

USER root

# Node.js 24 LTS через NodeSource (ставится в /usr/bin/node)
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates gnupg && \
    curl -fsSL https://deb.nodesource.com/setup_24.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Chromium/Playwright: системные библиотеки и шрифты.
# Без них Chromium падает с "error while loading shared libraries: libglib-2.0.so.0",
# а без fontconfig текст в скриншотах не отрисовывается.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      libnss3 libnspr4 libglib2.0-0 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 \
      libatspi2.0-0 libcups2 libdrm2 libgbm1 libx11-6 libx11-xcb1 libxcb1 \
      libxcomposite1 libxdamage1 libxext6 libxfixes3 libxrandr2 libxkbcommon0 \
      libpango-1.0-0 libcairo2 libasound2 fontconfig fonts-liberation \
      fonts-dejavu-core && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Заменяем ТОЛЬКО бинарник node — npm/npx/pnpm/yarn/corepack НЕ трогаем,
# они продолжат работать через новый Node через shebang #!/usr/bin/env node
RUN rm -f /usr/local/bin/node && \
    ln -sf /usr/bin/node /usr/local/bin/node

# Проверка: Node v24 + pnpm работает на нём. Если нет — сборка упадёт.
RUN node --version | grep -q "v24" && \
    echo "✅ Node: $(node --version)" && \
    pnpm --version && \
    echo "✅ pnpm works on Node $(node --version)" || \
    (echo "❌ ERROR: Node is not v24 or pnpm broken" && exit 1)

RUN apt-get update && apt-get install -y --no-install-recommends docker.io && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

USER dsh